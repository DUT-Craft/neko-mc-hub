# Public browser API origin. Leave empty to use same-origin /api. Nginx can
# proxy it directly in production; Nuxt also provides a fallback proxy for
# local or simple deployments without Nginx.
NUXT_PUBLIC_API_BASE=

# Backend origin used by SSR and the Nuxt /api fallback proxy. This address is
# never exposed to browsers.
NUXT_API_BASE_INTERNAL=http://127.0.0.1:8080

# Demo data must stay disabled on a real deployment.
NUXT_PUBLIC_ENABLE_DEMO_FALLBACK=false

# Keep / for a normal domain deployment. Subdirectory hosting needs /name/.
NUXT_APP_BASE_URL=/

# Nuxt production server. Nginx should proxy to this local listener.
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
